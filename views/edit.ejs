<!DOCTYPE html>
<html>

<head>

    <title>Edit Donor</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">

</head>

<body class="container mt-4">

    <nav class="navbar navbar-dark bg-danger mb-4">

        <div class="container-fluid">

            <a class="navbar-brand">
                🩸 BloodLink - Save Lives
            </a>

        </div>

    </nav>

    <h1 class="mb-4">
        Edit Donor
    </h1>

    <form
        action="/donors/<%= donor._id %>?_method=PUT"
        method="POST"
    >

        <input
            type="text"
            name="name"
            value="<%= donor.name %>"
            class="form-control mb-3"
        >

        <select
            name="bloodGroup"
            class="form-control mb-3"
        >

            <option <%= donor.bloodGroup === "A+" ? "selected" : "" %>>A+</option>
            <option <%= donor.bloodGroup === "A-" ? "selected" : "" %>>A-</option>
            <option <%= donor.bloodGroup === "B+" ? "selected" : "" %>>B+</option>
            <option <%= donor.bloodGroup === "B-" ? "selected" : "" %>>B-</option>
            <option <%= donor.bloodGroup === "AB+" ? "selected" : "" %>>AB+</option>
            <option <%= donor.bloodGroup === "AB-" ? "selected" : "" %>>AB-</option>
            <option <%= donor.bloodGroup === "O+" ? "selected" : "" %>>O+</option>
            <option <%= donor.bloodGroup === "O-" ? "selected" : "" %>>O-</option>

        </select>

        <input
            type="text"
            name="city"
            value="<%= donor.city %>"
            class="form-control mb-3"
        >

        <input
            type="text"
            name="phone"
            value="<%= donor.phone %>"
            class="form-control mb-3"
        >

        <button class="btn btn-success">
            Update Donor
        </button>

    </form>

</body>


<footer class="text-center mt-5 mb-3">

    <p>
        Made with ❤️ for social welfare
    </p>

</footer>

</html>