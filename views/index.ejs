<!DOCTYPE html>
<html>
<head>
    <title>🩸 BloodLink – Blood Donation Finder</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
<style>

.card:hover{
    transform: scale(1.03);
    transition: 0.3s;
}

</style>

</head>

<body class="container mt-4 style="background-color: #f8f9fa;">

<nav class="navbar navbar-dark bg-danger mb-4">

    <div class="container-fluid">

        <a class="navbar-brand">
           🩸 BloodLink - Save Lives
        </a>

    </div>

</nav>



    <h1 class="text-danger mb-4">Blood Donors</h1>
<p class="text-secondary">
    Total Donors: <%= donors.length %>
</p>
    <a href="/donors/new" class="btn btn-danger mb-3">
        Add Donor
    </a>
<form action="/search" class="mb-4">

    <select
        name="bloodGroup"
        class="form-control"
    >

        <option value="" disabled selected>
            Search Blood Group
        </option>

        <option>A+</option>
        <option>A-</option>
        <option>B+</option>
        <option>B-</option>
        <option>AB+</option>
        <option>AB-</option>
        <option>O+</option>
        <option>O-</option>

    </select>

    <button class="btn btn-dark mt-2">
        Search
    </button>

</form>

    <div class="row">

       <% if(donors.length === 0){ %>

    <h4 class="text-secondary">
        No donors available
    </h4>

<% } %>

<% donors.forEach(donor => { %>

            <div class="col-4">

                <div class="card mb-3 shadow">

                    <div class="card-body">

                        <h4><%= donor.name %></h4>

                        <p>
                            Blood Group:
                            <%= donor.bloodGroup %>
                        </p>

                        <p>
                            City:
                            <%= donor.city %>
                        </p>

                        <p>
                            Phone:
                            <%= donor.phone %>
                        </p>

                       
<form action="/donors/<%= donor._id %>?_method=DELETE" method="POST">

    <button class="btn btn-dark">
        Delete
    </button>

<a
    href="/donors/<%= donor._id %>/edit"
    class="btn btn-warning mt-0"
>
    Edit
</a>


</form>
                    </div>

                </div>

            </div>

        <% }) %>

    </div>

</body>
<footer class="text-center mt-5 mb-3">

    <p>
        Made with ❤️ for social welfare
    </p>

</footer>

</html>